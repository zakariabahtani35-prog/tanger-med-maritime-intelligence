# ==============================================================================
# MOROCCO PORT & MARITIME INTELLIGENCE PLATFORM (TANGER MED & CASABLANCA HUBS)
# Environment Configuration Template (.env.example)
# ==============================================================================

# --- Supabase PostgreSQL / PostGIS Cloud Warehouse ---
SUPABASE_URL=https://syaigxflutyefwszxpsr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_public_key_here
TARGET_TABLE=stg_vessel_ais_raw

# --- Operational Pipeline Mode ---
# Set to 'true' for real-time AIS kinematic simulator stream
# Set to 'false' for pure Supabase historical data warehouse analytics
SIMULATION_MODE=false

# --- Telemetry Ingestion Parameters ---
BATCH_SIZE=100
FLUSH_INTERVAL_SECONDS=5.0
SIMULATOR_TICK_INTERVAL=0.5
STRICT_GEOFENCE_CHECK=true

# --- Live AISStream WebSocket (Optional for real live satellite feeds) ---
AIS_WEBSOCKET_URL=wss://stream.aisstream.io/v0/stream
AIS_API_KEY=your_aisstream_api_key_here

# --- Server & Observability ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
