# Database Configuration (Supabase / PostgreSQL + PostGIS)
DATABASE_URL="https://syaigxflutyefwszxpsr.supabase.co"
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10

# Ingestion Pipeline Buffer & Flush Controls
BATCH_SIZE=100
FLUSH_INTERVAL_SECONDS=5

# AIS Stream Source & Simulation Mode
# Set SIMULATION_MODE=true to run deterministic simulation for Tanger Med & Casablanca
SIMULATION_MODE=true
AIS_WEBSOCKET_URL=wss://stream.aisstream.io/v0/stream
AIS_API_KEY="f27a6cc4fc2a55b930e10144e315c96cada3dd54"

# Geofence Bounds Enforcement (Moroccan Corridor)
STRICT_GEOFENCE_CHECK=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
